# Secrets and local credentials — NEVER commit anything under this directory
canonical/secrets/
.env
*.pem
*.key

# Local databases and SQLite sidecars
*.db
*.db-shm
*.db-wal
*.sqlite-shm
*.sqlite-wal
# Lane register: live runtime state, rewritten by every gate/lane operation.
state/concurrent-lane-register.sqlite

# Timestamped wiki LKG manifest rotations (keep canonical bootstrap-manifest.json)
wiki/.lkg/bootstrap-manifest.*Z.json

# Generated indexes and derived caches
vector/indexes/
derived/cache/
state/workflow-routing-index.json
derived/

# Graphify knowledge-graph artifacts (disposable derived output)
graphify-out/
# Isolated candidate snapshots built by A18 before promotion. Rebuildable from
# live source via `cron_graphify_code_refresh.py --promote-once`; ~38MB/wave and
# never committed since the layout was introduced.
source/graphify-candidates/

# Runtime logs and temporary files
telemetry/runtime/
*.log
*.tmp
__pycache__/
*.pyc

# Scratch workspace: keep only its retention contract in version control.
tmp/*
!tmp/README.md

# Windows null-device artifact from bad redirections
nul
