{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Graphify MCP benchmark cases",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "cases"],
  "properties": {
    "schema": {"const": "graphify-mcp-cases.v1"},
    "cases": {
      "type": "array",
      "minItems": 18,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "category",
          "question",
          "operation",
          "mcp_arguments",
          "expected_graph_behavior",
          "source_path",
          "source_line_hint",
          "proof_pattern",
          "search_terms",
          "fallback_policy"
        ],
        "properties": {
          "case_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "category": {"enum": ["topology_navigation", "symbol_relation", "boundary"]},
          "question": {"type": "string", "minLength": 1},
          "operation": {"enum": ["query_graph", "get_node", "get_neighbors", "get_community", "god_nodes", "graph_stats", "shortest_path"]},
          "mcp_arguments": {"type": "object"},
          "expected_graph_behavior": {"enum": ["locator", "relationship", "aggregate", "no_path"]},
          "source_path": {"type": "string", "minLength": 1},
          "source_line_hint": {"type": "integer", "minimum": 1},
          "proof_pattern": {"type": "string", "minLength": 1},
          "search_terms": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "fallback_policy": {"const": "source_fallback"}
        }
      }
    }
  }
}
